                nodeEl.addEventListener('click', (e) => {
                    e.preventDefault();
                    openModal(node.modal.title, node.modal.content);
                });
            }

            container.appendChild(nodeEl);

            // 计算节点位置
            let top;
            switch (level) {
                case 0: top = config.rootTop; break;
                case 1: top = config.level1Top; break;
                case 2: top = config.level2Top; break;
                case 3: top = config.level3Top; break;
                default: top = config.rootTop + level * config.levelGap;
            }

            const nodeWidth = nodeEl.offsetWidth;
            const nodeLeft = (left + right) / 2 - nodeWidth / 2;

            nodeEl.style.left = `${nodeLeft}px`;
            nodeEl.style.top = `${top}px`;

            // 存储位置
            nodePositions[node.id] = {
                x: nodeLeft + nodeWidth / 2,
                y: top + config.nodeHeight / 2,
                el: nodeEl
            };

            // 递归渲染子节点
            if (node.children && node.children.length > 0) {
                const childCount = node.children.length;
                const segmentWidth = (right - left) / childCount;
                node.children.forEach((child, index) => {
                    const childLeft = left + index * segmentWidth;
                    const childRight = left + (index + 1) * segmentWidth;
                    renderNode(child, node, childLeft, childRight, level + 1);
                    // 绘制父子连线
                    drawLink(node.id, child.id, child.level);
                });
            }
        }

        // 绘制贝塞尔曲线连线
        function drawLink(parentId, childId, level) {
            const svg = document.getElementById('treeSvg');
            const parent = nodePositions[parentId];
            const child = nodePositions[childId];

            if (!parent || !child) return;

            // 贝塞尔曲线控制点
            const controlY = (parent.y + child.y) / 2;
            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', `M ${parent.x} ${parent.y} C ${parent.x} ${controlY}, ${child.x} ${controlY}, ${child.x} ${child.y}`);
            path.setAttribute('class', `tree-link level-${level}`);
            svg.appendChild(path);
        }

        // 弹窗控制
        function openModal(title, content) {
            const modal = document.getElementById('modal');
            document.getElementById('modalTitle').textContent = title;
            document.getElementById('modalContent').innerHTML = content;
            modal.classList.add('active');
        }

        function closeModal() {
            const modal = document.getElementById('modal');
            modal.classList.remove('active');
        }

        // 事件监听
        document.getElementById('modalClose').addEventListener('click', closeModal);
        document.getElementById('modal').addEventListener('click', (e) => {
            if (e.target === document.getElementById('modal')) closeModal();
        });

        // 初始化渲染
        window.onload = () => {
            const containerWidth = document.getElementById('treeContainer').offsetWidth;
            renderNode(treeData, null, 0, containerWidth, 0);
        };

        // 窗口大小变化重绘
        window.onresize = () => {
            const container = document.getElementById('treeContainer');
            container.innerHTML = '<svg class="tree-svg" id="treeSvg"></svg>';
            const containerWidth = container.offsetWidth;
            renderNode(treeData, null, 0, containerWidth, 0);
        };
    </script>
</body>
</html>
