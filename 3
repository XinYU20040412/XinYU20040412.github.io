            'gradient-shift': 'gradientShift 8s ease infinite',
          },
          keyframes: {
            float: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-20px)' },
            },
            glow: {
              '0%': { boxShadow: '0 0 10px rgba(0, 228, 255, 0.3), 0 0 20px rgba(114, 46, 209, 0.3)' },
